  "rules": [
    {
      "id": "L01",
      "kind": "line",
      "feature": "life",
      "when": {},
      "topic": "general",
      "theme": "生活的底盘",
      "text": "这条弧线承担生活基础的意象，读法重在底盘与其他路径怎样衔接。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF41、54—60"
      },
      "priority": 10
    },
    {
      "id": "L02",
      "kind": "line",
      "feature": "head",
      "when": {},
      "topic": "general",
      "theme": "构思怎样展开",
      "text": "这条横斜线承担构思如何展开的意象，具体重心由走向与连接决定。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF41—42、60—64"
      },
      "priority": 10
    },
    {
      "id": "L03",
      "kind": "line",
      "feature": "heart",
      "when": {},
      "topic": "relationships",
      "theme": "关系中的联结",
      "text": "这条上部横纹承担关系联结的主题，终点与支线决定这层象意怎样展开。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF42、65—70"
      },
      "priority": 10
    },
    {
      "id": "L04",
      "kind": "line",
      "feature": "fate",
      "when": {},
      "topic": "career",
      "theme": "事业的主线",
      "text": "朝中指方向的纵纹承担事业主轴的意象，起点与连接决定这条路从哪里长出来。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF42、70—72"
      },
      "priority": 20
    },
    {
      "id": "L05",
      "kind": "line",
      "feature": "sun",
      "when": {},
      "topic": "career",
      "theme": "呈现与被看见",
      "text": "朝无名指根下的线承担作品、呈现和认可的意象，与事业主线合看最有信息。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF43、73—74"
      },
      "priority": 20
    },
    {
      "id": "F01",
      "kind": "line",
      "feature": "fate",
      "when": {
        "start": "life_line"
      },
      "topic": "career",
      "theme": "从已有积累中起势",
      "text": "这是一条从积累里长出的路：已有基础接入事业主轴，重心在承接与生长。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF71右，例86、图181"
      },
      "priority": 80
    },
    {
      "id": "F02",
      "kind": "line",
      "feature": "fate",
      "when": {
        "start": "moon_region"
      },
      "topic": "career",
      "theme": "借外缘形成事业",
      "text": "这是一种借势成路的象：先接住外部机会与合作，再逐步形成事业的主轴。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF71右—72左，例89、图184"
      },
      "priority": 80
    },
    {
      "id": "F03",
      "kind": "line",
      "feature": "fate",
      "when": {
        "double": true
      },
      "topic": "career",
      "theme": "并行的路径",
      "text": "两条清楚的纵向路径并行，象意里容得下两路推进；还要看两路怎样衔接、各自走向哪里。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF71右，例87、图182"
      },
      "priority": 70
    },
    {
      "id": "F04",
      "kind": "line",
      "feature": "fate",
      "when": {
        "continuity": "gap",
        "gap_confirmed": true,
        "overlap": false
      },
      "topic": "career",
      "theme": "阶段性的切换",
      "text": "这条路的象里有分段、有转折，读法要分前后承接，尤其要看中断附近有没有重新接起的路径。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF71右—72左，例88、90、图183、185"
      },
      "priority": 75
    },
    {
      "id": "F05",
      "kind": "line",
      "feature": "fate",
      "when": {
        "continuity": "continuous"
      },
      "topic": "career",
      "theme": "已见线段的连续",
      "text": "这段玉柱线在已看清的范围内连贯。连续这一项只描述该段形态，起点与连接关系另看。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF70右，例83—84"
      },
      "priority": 35,
      "scope": "observed-segment-only"
    },
    {
      "id": "S01",
      "kind": "line",
      "feature": "sun",
      "when": {
        "start": "life_line"
      },
      "topic": "career",
      "theme": "积累走向呈现",
      "text": "积累接到了呈现上，象意像是经验慢慢长成作品，再逐渐被看见。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF73左—右，例97、图192"
      },
      "priority": 75
    },
    {
      "id": "S02",
      "kind": "line",
      "feature": "sun",
      "when": {
        "start": "fate_line"
      },
      "topic": "career",
      "theme": "做事与呈现相连",
      "text": "做事与被看见接在一条路上：事业主轴向前走，呈现与认可随之展开。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF73右，例98、图193"
      },
      "priority": 85
    },
    {
      "id": "S03",
      "kind": "line",
      "feature": "sun",
      "when": {
        "start": "head_line"
      },
      "topic": "career",
      "theme": "构思走向作品",
      "text": "构思接到了呈现上，象意集中在把想法做成文字、内容或作品。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF74右，例104、图199"
      },
      "priority": 75
    },
    {
      "id": "S04",
      "kind": "line",
      "feature": "sun",
      "when": {
        "start": "heart_line"
      },
      "topic": "career",
      "theme": "关系与呈现相连",
      "text": "关系与呈现接在一起，读法重在人与人之间的联结，怎样进入表达和被看见的路径。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF73右—74左，例100、图195"
      },
      "priority": 70
    },
    {
      "id": "H01",
      "kind": "line",
      "feature": "head",
      "when": {
        "direction": "descending_outer"
      },
      "topic": "general",
      "theme": "头脑线向小指侧下行",
      "text": "原书把这类走势放在构思与想象的传统主题下；职业图例另有太阳线起点等配合条件。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF60—64"
      },
      "priority": 45,
      "scope": "attributed-traditional-theme"
    },
    {
      "id": "H02",
      "kind": "line",
      "feature": "head",
      "when": {
        "direction": "transverse"
      },
      "topic": "general",
      "theme": "横向铺开的构思",
      "text": "图形以横向展开为主，象意像把事情摊开、逐项铺陈，重心在展开的过程。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF41—42、60—64"
      },
      "priority": 40
    },
    {
      "id": "P01",
      "kind": "line",
      "feature": "life",
      "when": {
        "upward_branch": true
      },
      "topic": "general",
      "theme": "从基础向外伸展",
      "text": "向上的支线把已有底盘向外延展，象意重在基础之上再生出一个出口。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF47—49"
      },
      "priority": 35
    },
    {
      "id": "P02",
      "kind": "line",
      "feature": "fate",
      "when": {
        "upward_branch": true
      },
      "topic": "career",
      "theme": "主线向外伸展",
      "text": "事业主轴向上生出支线，象意是主路逐渐有了延展与新的出口。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF47—49"
      },
      "priority": 40
    },
    {
      "id": "P03",
      "kind": "line",
      "feature": "sun",
      "when": {
        "double": true
      },
      "topic": "career",
      "theme": "多处呈现",
      "text": "呈现有不止一个出口，需要看各线起点，分清是同一路的延展还是彼此独立。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF73—74，图196"
      },
      "priority": 45
    },
    {
      "id": "R01",
      "kind": "line",
      "feature": "heart",
      "when": {
        "continuity": "continuous"
      },
      "topic": "relationships",
      "theme": "关系主题的延续",
      "text": "当前可见部分连贯，关系主题在象意上有延续和连接的主调。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF42、65—70"
      },
      "priority": 35
    },
    {
      "id": "R02",
      "kind": "line",
      "feature": "heart",
      "when": {
        "upward_branch": true
      },
      "topic": "relationships",
      "theme": "关系向外延展",
      "text": "关系主题生出向上的支线，象意是联结向外延展，再看支线具体走向哪一区域。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF47—49、65—70"
      },
      "priority": 40
    },
    {
      "id": "Y01",
      "kind": "symbol",
      "feature": "triangle",
      "when": {
        "independent": true,
        "closed": true,
        "edge_count": 3
      },
      "topic": "general",
      "theme": "局部结构的聚合",
      "text": "已经认出独立三边结构；这一步先抓住局部聚合的形态，下一层由所在区域和主线配合决定。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF49右、51—52"
      },
      "priority": 15
    },
    {
      "id": "Y02",
      "kind": "symbol",
      "feature": "square",
      "when": {
        "independent": true,
        "closed": true,
        "edge_count": 4
      },
      "topic": "general",
      "theme": "围合与承接",
      "text": "独立四边结构带出围合与承接的意象，具体落点由它所在的位置和相关主线决定。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF50—52"
      },
      "priority": 15
    },
    {
      "id": "F06",
      "kind": "line",
      "feature": "fate",
      "when": {
        "continuity": "overlapping",
        "overlap": true
      },
      "topic": "career",
      "theme": "前后段搭接",
      "text": "前后两段有已确认的重叠。原课把搭接与真正空缺分开，先看重叠位置，再看后段走向；这一项记录的是已见连接方式。",
      "source": {
        "id": "sari-fate-broken",
        "locator": "4:30–5:58，搭接与空缺两段讲解"
      },
      "priority": 60,
      "scope": "observed-segment-only"
    }
