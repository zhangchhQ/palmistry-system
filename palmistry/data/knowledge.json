  "combinations": [
    {
      "id": "C01",
      "requires": [
        "F02",
        "S02"
      ],
      "minimum_observations": 2,
      "text": "陈氏把月丘起线联系到外部来路，把太阳线联系到成果与认可。两条线明确接在一起，所以这组图沿着来路讲到成果。",
      "title": "外部来路与成果接在一起",
      "forecast_scope": "none",
      "requires_same_observation_per_feature": true,
      "limits": [
        "连续只描述已见线段",
        "不生成个人年份、收入、人格或诊断结论"
      ]
    },
    {
      "id": "C02",
      "requires": [
        "F01",
        "S02"
      ],
      "minimum_observations": 2,
      "text": "这组图的来路落在生命线，按陈氏读法从已有基础讲起；太阳线又接上玉柱线，解释就顺着这个接头走到成果与认可。",
      "title": "从已有根基讲到成果",
      "forecast_scope": "none",
      "requires_same_observation_per_feature": true,
      "limits": [
        "连续只描述已见线段",
        "不生成个人年份、收入、人格或诊断结论"
      ]
    },
    {
      "id": "C03",
      "requires": [
        "F04",
        "S02"
      ],
      "minimum_observations": 2,
      "text": "玉柱线上有已核实的间断，太阳线同时与具体玉柱相接。断在哪里、太阳线接在哪里，要分别交代；当前组合没有前后段先败后成的时间证据。",
      "title": "间断与连接分别看",
      "forecast_scope": "none",
      "requires_same_observation_per_feature": true,
      "limits": [
        "连续只描述已见线段",
        "不生成个人年份、收入、人格或诊断结论"
      ]
    },
    {
      "id": "C04",
      "requires": [
        "F03",
        "S02"
      ],
      "minimum_observations": 2,
      "text": "玉柱形态可见双重路径，太阳线又与这一组纵纹相接。应先分清太阳线具体接在哪一支，再说明两路的关系。",
      "title": "两路并行，呈现线另看接头",
      "forecast_scope": "none",
      "requires_same_observation_per_feature": true,
      "limits": [
        "连续只描述已见线段",
        "不生成个人年份、收入、人格或诊断结论"
      ]
    },
    {
      "id": "C05",
      "requires": [
        "F02",
        "S02",
        "F05"
      ],
      "minimum_observations": 2,
      "text": "陈氏把月丘起线联系到外部来路，把太阳线联系到成果与认可。这里两条线接在一起，因此这组图读作“外缘入路，做事见名”。",
      "title": "先看外部机会，再看做出的成果",
      "forecast_scope": "none",
      "requires_same_observation_per_feature": true,
      "limits": [
        "连续只描述已见线段",
        "不生成个人年份、收入、人格或诊断结论"
      ]
    },
    {
      "id": "C06",
      "requires": [
        "H01",
        "S03"
      ],
      "minimum_observations": 2,
      "title": "下斜头脑线与太阳线相接",
      "text": "太阳线从这条向小指侧下行的头脑线发出。陈氏在该图中把两条线合看，传统主题落在构思通向作品与呈现；决定这组解释的是明确的起点连接。",
      "source": {
        "id": "chen-1994",
        "locator": "PDF74右，例104、图199"
      },
      "forecast_scope": "none",
      "requires_same_observation_per_feature": true,
      "limits": [
        "单有下斜头脑线不等于该组合成立",
        "不判定个人天赋、职业成败或收益"
      ]
    }
